---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'ama434.dev';
const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const navItems = [
  { href: '/', label: 'Top' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/slide/', label: 'Slide' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{siteName}</a>
      <nav aria-label="サイト内">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© ama434</p>
      <p>
        文章と自作の作品は <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.ja" rel="license">CC BY-SA 4.0</a>、ソフトウェアとコード例は MIT License で提供します。
      </p>
    </footer>
  </body>
</html>
